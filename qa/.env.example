# Copy to qa/.env. Generate unique values; never commit the real file.
QA_DB_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
QA_DB_APP_PASSWORD=replace-with-a-different-long-random-app-password
QA_JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-random-bytes
QA_STAFF_DATA_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
QA_STAFF_DATA_LOOKUP_KEY=replace-with-different-base64-of-32-random-bytes
QA_CUSTOMER_DATA_ENCRYPTION_KEY=replace-with-another-base64-of-32-random-bytes
# Use URL-encoded app password in this DSN if it contains reserved characters.
QA_IA_POSTGRES_DSN=postgresql+asyncpg://mottainai_qa_app:replace-with-url-encoded-app-password@postgres:5432/mottainai_qa
QA_ANALYTICS_ADMIN_PASSWORD=replace-with-a-different-long-random-analytics-admin-password
# Use an alphanumeric password, because Compose embeds it in the analytics DSN.
QA_ANALYTICS_READER_PASSWORD=replace-with-a-long-alphanumeric-reader-password
QA_IA_JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
QA_REDIS_PASSWORD=replace-with-a-long-alphanumeric-redis-password
QA_MONGO_USER=qa_mongo_admin
QA_MONGO_PASSWORD=replace-with-a-long-alphanumeric-mongo-password
QA_GROQ_API_KEY=
